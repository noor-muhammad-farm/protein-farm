rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['noormuhammadproteinfarm@gmail.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && (isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    // Stock items - readable by any authenticated user, writable by admin
    match /stock_items/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Stock history - readable by any authenticated user, writable by admin
    match /stock_history/{historyId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Sales - strictly for admins
    match /sales/{saleId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Settings (including contact info) - publicly readable, writable by admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Gallery photos - publicly readable, writable by admin
    match /gallery_photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Diagnostic/connection test probe
    match /test/connection {
      allow read: if true;
    }
  }
}
